{
    "name": "tomvis/himpro-framework",
    "description": "Tomvis Hospital Information Management Framework for HIMPro",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "TomvisHIMPro Core Team",
            "role": "Healthcare Systems Architect"
        }
    ],
    "require": {
        "php": ">=8.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tomvis\\HIMPro\\": "app/",
            "Tomvis\\HIMPro\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tomvis\\HIMPro\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php -l public/index.php bootstrap/app.php",
        "tomvis": "php scripts/tomvis"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
